// CloudFront Function, viewer request, runtime cloudfront-js-2.0.
// Rendered by Terraform (modules/static-site); edit the template, not the deployed code.
// 1. A host in REDIRECT_HOSTS answers 301 to the canonical host; path and query stay.
// 2. A path ending in "/" serves its index.html.
// 3. A path whose last segment has no dot answers 301 to the same path with "/" added,
//    as GitHub Pages does for directory pages.
var CANONICAL_HOST = ${jsonencode(canonical_host)};
var REDIRECT_HOSTS = ${jsonencode(redirect_hosts)};

function querySuffix(querystring) {
  var parts = [];
  for (var key in querystring) {
    var entry = querystring[key];
    var values = entry.multiValue ? entry.multiValue : [entry];
    for (var i = 0; i < values.length; i++) {
      parts.push(values[i].value === '' ? key : key + '=' + values[i].value);
    }
  }
  return parts.length > 0 ? '?' + parts.join('&') : '';
}

function redirect(location) {
  return {
    statusCode: 301,
    statusDescription: 'Moved Permanently',
    headers: { location: { value: location } }
  };
}

function handler(event) {
  var request = event.request;
  var host = request.headers.host ? request.headers.host.value.toLowerCase() : CANONICAL_HOST;
  var uri = request.uri;

  if (REDIRECT_HOSTS.indexOf(host) !== -1) {
    return redirect('https://' + CANONICAL_HOST + uri + querySuffix(request.querystring));
  }

  if (uri.endsWith('/')) {
    request.uri = uri + 'index.html';
    return request;
  }

  var last = uri.substring(uri.lastIndexOf('/') + 1);
  if (last.indexOf('.') === -1) {
    return redirect('https://' + host + uri + '/' + querySuffix(request.querystring));
  }

  return request;
}
